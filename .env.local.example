# Copiar este archivo a .env.local y completar con los valores reales del
# proyecto de Supabase (Project Settings > API). .env.local nunca se sube al
# repositorio (ver .gitignore).

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# anon key (pública, limitada por RLS) — segura para el frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (acceso total, sin RLS) — SOLO servidor, jamás exponer
# al frontend ni commitear al repositorio
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (captcha anti-spam del RSVP, CLAUDE.md §7)
# Site Key: pública, se usa en el widget del navegador
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret Key: privada, SOLO servidor, para verificar el token
TURNSTILE_SECRET_KEY=
