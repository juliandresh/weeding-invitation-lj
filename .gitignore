# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# claude code (config local del usuario/máquina, no compartir)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# assets originales sin procesar (fotos/audio/imágenes en bruto antes de
# optimizar e incorporar a public/) — no se versionan, solo la copia final
/music/
/fotos-originales/
/assets-originales/
